{
  "name": "@cinagroup/brand",
  "version": "2.1.0",
  "description": "Versioned CinaGroup and product brand assets, tokens, and metadata.",
  "type": "module",
  "license": "SEE LICENSE IN BRAND_POLICY.md",
  "files": [
    "assets",
    "products",
    "sources",
    "brand.json",
    "BRAND_GUIDELINES.md",
    "BRAND_POLICY.md",
    "checksums.sha256"
  ],
  "exports": {
    "./brand.json": "./brand.json",
    "./heritage": "./assets/heritage/manifest.json",
    "./products/cinaseek": "./products/cinaseek/brand.json",
    "./products/cinaseek/terminology": "./products/cinaseek/terminology.json",
    "./products/cinaseek/tokens.css": "./products/cinaseek/tokens.css"
  },
  "scripts": {
    "build": "node scripts/build-heritage.mjs",
    "test": "node scripts/validate.mjs && node scripts/verify-heritage.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "opentype.js": "2.0.0",
    "sharp": "0.35.4"
  }
}
